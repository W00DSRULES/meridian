# Server only. Do not prefix these with NEXT_PUBLIC_, and do not commit real keys.
# Copy this file to .env.local and fill in the project URL and service role key
# from the Supabase dashboard (Project Settings → API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public origin for invite links, such as https://meridian.example.com
# Leave empty while the app is only on this machine. Do not use http://127.0.0.1.
MERIDIAN_PUBLIC_URL=
